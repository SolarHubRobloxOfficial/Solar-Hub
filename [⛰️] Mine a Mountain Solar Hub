-- Логика Auto Sell
sellBtn.MouseButton1Click:Connect(function()
    local character = localPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    sellBtn.Text = "Синхронизация..."
    local oldCFrame = rootPart.CFrame
    local oldCameraType = camera.CameraType
    local shopPosition = CFrame.new(-40, 29, 1067)
    rootPart.CFrame = shopPosition
    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = shopPosition * CFrame.new(0, 5, 10)
    task.wait(0.35)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and remotes:FindFirstChild("SellRequest") then remotes.SellRequest:FireServer("all") end
    task.wait(0.15)
    rootPart.CFrame = oldCFrame
    camera.CameraType = oldCameraType
    sellBtn.Text = "Auto Sell"
end)

