local nc; nc = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" and self.Name == "FallDamage" then
        return nil -- Полностью блокируем отправку урона на сервер
    end
    return nc(self, ...)
end)

