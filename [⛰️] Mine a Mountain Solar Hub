-- БЕЗОПАСНЫЙ СБОРЩИК (С защитой от падения и холода)
task.spawn(function()
    while true do
        task.wait(0.4) -- Оптимальная задержка против античита
        
        if autoPickupActive then
            local character = localPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            if rootPart and humanoid then
                for _, v in ipairs(workspace:GetDescendants()) do
                    if not autoPickupActive then break end
                    
                    if v:IsA("ProximityPrompt") then
                        local crystal = v.Parent
                        
                        if crystal and crystal:IsA("BasePart") and (string.find(crystal.Name, "Crystal") or string.find(crystal.Name, "Ore") or string.find(string.lower(v.ActionText), "pickup")) then
                            
                            -- Запоминаем позицию БАЗЫ, чтобы улететь от холода
                            local safePosition = rootPart.CFrame
                            
                            -- Обнуляем скорость падения персонажа (чтобы не было урона физики)
                            rootPart.Velocity = Vector3.new(0, 0, 0)
                            
                            -- Переносим ИДЕАЛЬНО на кристалл (не высоко)
                            rootPart.CFrame = crystal.CFrame * CFrame.new(0, 0.5, 0)
                            task.wait(0.12)
                            
                            -- Собираем
                            fireproximityprompt(v)
                            task.wait(0.1)
                            
                            -- МГНОВЕННО возвращаем на безопасную теплую базу
                            rootPart.CFrame = safePosition
                            rootPart.Velocity = Vector3.new(0, 0, 0)
                            
                            break -- Уходим на проверку следующего кристалла
                        end
                    end
                end
            end
        end
    end
end)

